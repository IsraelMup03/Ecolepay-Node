# Dépendances (les fichiers lourds téléchargés)
node_modules/
.pnpm-store/

# Dossiers de build (les fichiers compilés pour la production)
dist/
build/

# Fichiers de configuration personnels (contenant vos mots de passe MySQL/API)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Fichiers d'historique et de logs de crash
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
*.log

# Fichiers système invisibles (Mac et Windows)
.DS_Store
Thumbs.db

# Copie(s) de sauvegarde auto-generee(s) par le serveur (voir backend/src/server.js) : n'ont
# rien a faire dans le depot, chaque installation/poste a la sienne. Le second motif couvre
# le fichier maitre temporaire (prefixe d'un point) au cas ou il resterait suite a un arret
# brutal en plein milieu d'une sauvegarde.
COPIE DE SECURITE*
.COPIE DE SECURITE*

# Fichiers compagnons du mode WAL de SQLite (voir backend/src/config/db.js) : transitoires,
# regeneres automatiquement, propres a chaque poste -- jamais a versionner.
*.sqlite-wal
*.sqlite-shm