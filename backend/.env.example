# Copiez ce fichier en .env et ajustez les valeurs

# Base de données MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ecolepay
DB_USER=root
DB_PASS=

# Serveur
PORT=5000

# Sécurité JWT (changez cette valeur en production !)
JWT_SECRET=change-moi-en-production-avec-une-longue-chaine-aleatoire
JWT_EXPIRES_IN=12h

# URL du frontend (pour CORS)
FRONTEND_URL=http://localhost:5173
