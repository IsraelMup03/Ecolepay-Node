# Copiez ce fichier en .env et ajustez les valeurs si besoin.
# (Le script d'installation install.bat le fait automatiquement et genere
# un JWT_SECRET unique et aleatoire a votre place.)

# Base de donnees : sqlite (par defaut, aucune installation supplementaire requise)
# ou mysql (necessite un serveur MySQL deja installe, voir DB_HOST/DB_NAME/DB_USER/DB_PASS)
DB_CLIENT=sqlite
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ecolepay
DB_USER=root
DB_PASS=

# Serveur
PORT=5055

# Securite JWT - NE JAMAIS reutiliser cette valeur telle quelle, chaque installation
# doit avoir son propre secret unique (genere automatiquement par install.bat)
JWT_SECRET=changez-cette-valeur-avant-tout-lancement-en-production
JWT_EXPIRES_IN=12h

# URL du frontend (pour CORS) - laissez vide si le frontend est servi par ce meme
# serveur (cas normal d'une installation cliente packagee avec install.bat)
FRONTEND_URL=
